rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ubaidullahbhutto1998@gmail.com' ||
        (request.auth.token.email_verified == true && request.auth.token.email.matches('.*@albasitbuilders\\.com$')) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Plots collection
    match /plots/{plotId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Installments collection
    match /installments/{installmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin(); // only admin can adjust/reverse transactions
      allow delete: if false; // immutable financial log
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // immutable audit logs
    }
  }
}
